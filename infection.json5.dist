{
	$schema: 'vendor/infection/infection/resources/schema.json',
	source: {
		directories: ['src'],
	},
	tmpDir: '.infection',
	logs: {
		text: '.infection/infection.log',
		html: '.infection/infection.html',
		summary: '.infection/summary.log',
	},
	// Ratchet: raise these with the reached score, never lower them.
	minMsi: 100,
	minCoveredMsi: 100,
	// CI mutates only the lines changed by a push; pushes without source
	// changes produce no mutants and must not fail the threshold.
	ignoreMsiWithNoMutations: true,
	// Ignores below cover equivalent mutants: they change no observable behavior.
	// Keep them scoped to a method (or a source-line regex) so that new code
	// elsewhere is still mutated; never pin `Class::method::line`.
	mutators: {
		'@default': true,

		// Fast paths: wrapping the registry without overrides resolves the
		// same entries.
		ReturnRemoval: {
			ignore: [
				'Celema\\Sire\\Config::resolvedRuleRegistry',
				'Celema\\Sire\\Config::resolvedCoercerRegistry',
			],
		},

		// The default exception code is not part of the contract.
		DecrementInteger: {
			ignore: ['Celema\\Sire\\Exception\\ValidationError::__construct'],
		},
		IncrementInteger: {
			ignore: ['Celema\\Sire\\Exception\\ValidationError::__construct'],
		},

		// Rule arguments are numeric strings and the values are numbers or
		// lengths, so PHP compares them numerically with or without the casts.
		CastInt: {
			ignore: [
				'Celema\\Sire\\Rule\\MaxLength::validate',
				'Celema\\Sire\\Rule\\MinLength::validate',
			],
		},
		CastFloat: {
			ignore: [
				'Celema\\Sire\\Rule\\Maximum::validate',
				'Celema\\Sire\\Rule\\Minimum::validate',
			],
		},

		// Blocked rule paths are only checked with array_key_exists().
		TrueValue: {
			ignore: ['Celema\\Sire\\ValidationRun::blockRules'],
		},

		// The raw empty flag only reaches extra values and failed shape values;
		// rules never run on either, so the flag is never read.
		Identical: {
			ignore: ['Celema\\Sire\\ValidationRun::isRawEmptyValue'],
		},
		LogicalOr: {
			ignore: ['Celema\\Sire\\ValidationRun::isRawEmptyValue'],
		},
		LogicalOrAllSubExprNegation: {
			ignore: ['Celema\\Sire\\ValidationRun::isRawEmptyValue'],
		},
		LogicalOrNegation: {
			ignore: ['Celema\\Sire\\ValidationRun::isRawEmptyValue'],
		},
	},
}
